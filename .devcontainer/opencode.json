{
  "$schema": "https://opencode.ai/config.json",

  "model": "nvidia/google/gemma-4-31b-it",

  "instructions": ["AGENTS.md"],

  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": "allow"
  },

  "autoupdate": false,
  "share": "disabled",
  "logLevel": "INFO",

  "tool_output": { "max_lines": 200 },
  "compaction": { "auto": true }
}
